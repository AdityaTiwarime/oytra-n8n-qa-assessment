{
  "name": "Task 2 - GitHub AI Repos Morning Brief",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "morning-brief",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Webhook (manual test)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 400],
      "webhookId": "7c1d2a8e-3b4f-4c5d-9e6f-0a1b2c3d4e5f"
    },
    {
      "parameters": {
        "url": "https://api.github.com/search/repositories",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=topic:ai-agents created:>{{ $now.minus({ days: 7 }).toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "sort",
              "value": "stars"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-morning-brief"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "GitHub - search new AI agent repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Keep only the 5 most-starred repos and drop fields we don't need.\nconst items = $input.first().json.items || [];\n\nif (items.length === 0) {\n  // Nothing new this week: send an explicit 'no results' brief instead of failing.\n  return [{ json: { empty: true, top: [], leader: { name: 'no new repos', owner: '-', repo: '-', stars: 0 } } }];\n}\n\nconst top = items\n  .filter(r => !r.fork && !r.archived)\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)\n  .slice(0, 5)\n  .map((r, i) => ({\n    rank: i + 1,\n    name: r.full_name,\n    owner: r.owner.login,\n    repo: r.name,\n    stars: r.stargazers_count,\n    language: r.language || 'n/a',\n    description: (r.description || '').slice(0, 140),\n    url: r.html_url,\n  }));\n\nreturn [{ json: { empty: false, top, leader: top[0] } }];"
      },
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "Keep top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 220]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.leader.owner }}/{{ $json.leader.repo }}/readme",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-morning-brief"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "readme"
            }
          }
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000005",
      "name": "GitHub - fetch README of #1 repo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 220],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Combine the top-5 list with a short README summary of the #1 repo.\nconst data = $('Keep top 5').first().json;\nconst raw = $input.first().json.readme || '';\nconst readmeOk = typeof raw === 'string' && raw.length > 0;\n\n// First meaningful paragraph of the README, markdown stripped.\nconst summary = readmeOk\n  ? raw\n      .replace(/<[^>]+>/g, ' ')\n      .replace(/!?\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1')\n      .split(/\\n\\s*\\n/)\n      .map(p => p.replace(/[#*`>_-]/g, '').replace(/\\s+/g, ' ').trim())\n      .find(p => p.length > 60) || ''\n  : '';\n\nreturn [{ json: {\n  ...data,\n  stars: data.leader.stars,\n  readmeSummary: summary.slice(0, 280) || '(README unavailable)',\n} }];"
      },
      "id": "a1f0c001-0000-4000-8000-000000000006",
      "name": "Build digest data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c0ffee00-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.stars }}",
              "rightValue": 1000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000007",
      "name": "Stars > 1000?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 220]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst list = d.top.map(r => `${r.rank}. **${r.name}** ⭐ ${r.stars} (${r.language})\\n   ${r.description}\\n   <${r.url}>`).join('\\n');\nreturn [{ json: { message: `🔥 **Morning brief: a breakout AI-agent repo this week**\\n#1 ${d.leader.name} already has ${d.leader.stars} stars.\\n> ${d.readmeSummary}\\n\\n**Top 5 new AI-agent repos (last 7 days)**\\n${list}` } }];"
      },
      "id": "a1f0c001-0000-4000-8000-000000000008",
      "name": "Format: breakout",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 120]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst list = d.top.map(r => `${r.rank}. **${r.name}** ⭐ ${r.stars} (${r.language})\\n   <${r.url}>`).join('\\n');\nreturn [{ json: { message: `🌱 **Morning brief: quiet week for AI-agent repos**\\nNo new repo passed 1000 stars yet. Leader: ${d.leader.name} (⭐ ${d.leader.stars}).\\n> ${d.readmeSummary}\\n\\n**Top 5**\\n${list}` } }];"
      },
      "id": "a1f0c001-0000-4000-8000-000000000009",
      "name": "Format: quiet week",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 320]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.message.slice(0, 1990) }}",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000010",
      "name": "Send digest to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1820, 220],
      "credentials": {
        "discordWebhookApi": {
          "id": "",
          "name": "Discord Webhook account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Fallback when the README call fails: still send the top-5 list.\nconst data = $('Keep top 5').first().json;\nreturn [{ json: { ...data, stars: data.leader.stars, readmeSummary: '(README could not be fetched; showing list only)' } }];"
      },
      "id": "a1f0c001-0000-4000-8000-000000000011",
      "name": "README failed: continue without it",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 420]
    },
    {
      "parameters": {
        "jsCode": "// Log any API failure with context so it never fails silently.\nconst err = $input.first().json.error || $input.first().json;\nconst entry = {\n  at: new Date().toISOString(),\n  step: $prevNode.name,\n  message: (err && (err.message || err.description)) || JSON.stringify(err).slice(0, 300),\n};\nconsole.log('[morning-brief] API error', entry);\nreturn [{ json: { ...entry, message: `⚠️ **Morning brief failed** at step \"${entry.step}\"\\n${entry.message}\\n(${entry.at})` } }];"
      },
      "id": "a1f0c001-0000-4000-8000-000000000012",
      "name": "Log API error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 560]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.message }}",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000013",
      "name": "Alert error to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1560, 560],
      "credentials": {
        "discordWebhookApi": {
          "id": "",
          "name": "Discord Webhook account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Last-resort: Discord itself failed. Surface it in the execution log.\nconst e = $input.first().json;\nconsole.error('[morning-brief] Discord delivery failed', e);\nreturn [{ json: { deliveryFailed: true, at: new Date().toISOString(), detail: e.error || e } }];"
      },
      "id": "a1f0c001-0000-4000-8000-000000000014",
      "name": "Discord failed: log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2080, 320]
    }
  ],
  "connections": {
    "Every hour": {
      "main": [[{ "node": "GitHub - search new AI agent repos", "type": "main", "index": 0 }]]
    },
    "Webhook (manual test)": {
      "main": [[{ "node": "GitHub - search new AI agent repos", "type": "main", "index": 0 }]]
    },
    "GitHub - search new AI agent repos": {
      "main": [
        [{ "node": "Keep top 5", "type": "main", "index": 0 }],
        [{ "node": "Log API error", "type": "main", "index": 0 }]
      ]
    },
    "Keep top 5": {
      "main": [[{ "node": "GitHub - fetch README of #1 repo", "type": "main", "index": 0 }]]
    },
    "GitHub - fetch README of #1 repo": {
      "main": [
        [{ "node": "Build digest data", "type": "main", "index": 0 }],
        [{ "node": "README failed: continue without it", "type": "main", "index": 0 }]
      ]
    },
    "README failed: continue without it": {
      "main": [[{ "node": "Stars > 1000?", "type": "main", "index": 0 }]]
    },
    "Build digest data": {
      "main": [[{ "node": "Stars > 1000?", "type": "main", "index": 0 }]]
    },
    "Stars > 1000?": {
      "main": [
        [{ "node": "Format: breakout", "type": "main", "index": 0 }],
        [{ "node": "Format: quiet week", "type": "main", "index": 0 }]
      ]
    },
    "Format: breakout": {
      "main": [[{ "node": "Send digest to Discord", "type": "main", "index": 0 }]]
    },
    "Format: quiet week": {
      "main": [[{ "node": "Send digest to Discord", "type": "main", "index": 0 }]]
    },
    "Send digest to Discord": {
      "main": [
        [],
        [{ "node": "Discord failed: log", "type": "main", "index": 0 }]
      ]
    },
    "Log API error": {
      "main": [[{ "node": "Alert error to Discord", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {},
  "active": false
}
